# ─── Live Market Data ─────────────────────────────────────────────
# Free API key from https://www.alphavantage.co/support/#api-key
# Without this, the platform uses realistic simulated data.
ALPHA_VANTAGE_API_KEY=your_free_api_key_here

# ─── Optional: additional data providers ──────────────────────────
# TWELVE_DATA_API_KEY=your_key_here

# ─── Stripe ───────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ─── Session ──────────────────────────────────────────────────────
# Any 32+ character random string: openssl rand -hex 32
SESSION_SECRET=your_32_char_secret_here

# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Mailchimp ────────────────────────────────────────────────────
# Get API key from https://mailchimp.com/help/about-api-keys/
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_LIST_ID=your-list-id
MAILCHIMP_SERVER_PREFIX=us1
