# ─── FlowEdge environment ─────────────────────────────────────────
# Everything is optional for local development: without keys the app
# runs on the mock/simulated provider chain end to end.

# PostgreSQL — enables persistence (signals, journal, settings).
# Without it, FlowEdge uses seeded in-memory stores.
# DATABASE_URL=postgresql://user:pass@localhost:5432/flowedge

# ─── Market data providers (optional) ─────────────────────────────
# Free key: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_key_here

# Economic calendar provider (mock calendar used when unset)
# CALENDAR_API_KEY=your_key_here

# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
