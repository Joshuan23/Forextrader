//@version=6
// ─────────────────────────────────────────────────────────────────────
// FlowEdge Signal Feeder — chart-native setup detection for TradingView
//
// PHILOSOPHY: this script detects TECHNICAL setups only and ships the
// chart context as JSON to the FlowEdge webhook. It does NOT know macro
// events, broker spreads, slippage history, or expectancy — that context
// lives in the FlowEdge app, which approves, downgrades, or blocks.
//
// Setup: create an alert on this indicator → condition "Any alert()
// function call" → webhook URL https://<your-app>/api/webhooks/tradingview
// The alert message is generated by the script (leave the box empty).
// Recommended timeframes: 5m / 15m. Pairs: EURUSD GBPUSD USDJPY AUDUSD
// USDCAD (XAUUSD optional).
// ─────────────────────────────────────────────────────────────────────
indicator("FlowEdge Signal Feeder", overlay = true, max_labels_count = 100)

// ── Inputs ───────────────────────────────────────────────────────────
grpAuth  = "FlowEdge"
secret   = input.string("CHANGE_ME_MIN_8_CHARS", "Webhook secret", group = grpAuth, tooltip = "Must match TRADINGVIEW_WEBHOOK_SECRET in the app")
mode     = input.string("watchlist", "Mode", options = ["watchlist", "automation"], group = grpAuth, tooltip = "watchlist: informational alerts. automation: app may route to execution later")

grpTech  = "Technical inputs"
emaFastLen  = input.int(21,  "EMA fast", minval = 2, group = grpTech)
emaSlowLen  = input.int(50,  "EMA slow", minval = 5, group = grpTech)
atrLen      = input.int(14,  "ATR length", minval = 2, group = grpTech)
rsiLen      = input.int(14,  "RSI length", minval = 2, group = grpTech)
useRsi      = input.bool(true, "Send RSI in payload", group = grpTech)
pivotLen    = input.int(3,   "Swing pivot bars (left/right)", minval = 1, maxval = 10, group = grpTech)
rangeLen    = input.int(20,  "Range lookback (bars)", minval = 10, group = grpTech)
cooldownBars = input.int(12, "Cooldown bars between alerts", minval = 1, group = grpTech)

grpSetups = "Setups enabled"
useTrendPullback = input.bool(true,  "Trend pullback continuation", group = grpSetups)
useBreakout      = input.bool(true,  "Breakout continuation",       group = grpSetups)
useRangeReject   = input.bool(true,  "Range rejection",             group = grpSetups)
useSessionBreak  = input.bool(true,  "London session breakout of Asia range", group = grpSetups)

grpSess = "Session filter (UTC)"
tradeAsia    = input.bool(false, "Allow Asia (23–07)",   group = grpSess)
tradeLondon  = input.bool(true,  "Allow London (07–16)", group = grpSess)
tradeNewYork = input.bool(true,  "Allow New York (12–21)", group = grpSess)

// ── Core series ──────────────────────────────────────────────────────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atr     = ta.atr(atrLen)
rsi     = ta.rsi(close, rsiLen)

// Swing tracking: last confirmed pivot high/low
ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)
var float swingHigh = na
var float swingLow  = na
if not na(ph)
    swingHigh := ph
if not na(pl)
    swingLow := pl

// Sessions (UTC hours)
utcH = hour(time, "UTC")
inAsia    = utcH >= 23 or utcH < 7
inLondon  = utcH >= 7 and utcH < 16
inNewYork = utcH >= 12 and utcH < 21
inDeadZone = utcH >= 21 and utcH < 23
sessionTag = inLondon and inNewYork ? "london_ny_overlap" : inLondon ? "london" : inNewYork ? "newyork" : inAsia ? "asia" : "dead_zone"
sessionAllowed = (inLondon and tradeLondon) or (inNewYork and tradeNewYork) or (inAsia and not inLondon and tradeAsia)

// Asia range for the session breakout (23:00 → 07:00 UTC)
var float asiaHigh = na
var float asiaLow  = na
var bool  asiaBroken = false
newAsia = utcH == 23 and utcH[1] != 23
if newAsia
    asiaHigh := high
    asiaLow := low
    asiaBroken := false
if inAsia and not newAsia
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow  := math.min(nz(asiaLow, low), low)

// Trend state
upTrend   = emaFast > emaSlow and close > emaSlow
downTrend = emaFast < emaSlow and close < emaSlow
flatEmas  = math.abs(emaFast - emaSlow) < 0.3 * atr

// Range extremes (prior bars only — no lookahead)
rangeHigh = ta.highest(high, rangeLen)[1]
rangeLow  = ta.lowest(low, rangeLen)[1]

// ── Setup detection (evaluated on confirmed bars only) ───────────────
// 1. Trend pullback: trend intact, bar dipped into the fast EMA zone and
//    closed back in trend direction.
pullLong  = useTrendPullback and upTrend   and low  <= emaFast + 0.1 * atr and close > emaFast and close > open
pullShort = useTrendPullback and downTrend and high >= emaFast - 0.1 * atr and close < emaFast and close < open

// 2. Breakout continuation: close breaks the last swing extreme with trend.
brkLong  = useBreakout and upTrend   and not na(swingHigh) and close > swingHigh and close[1] <= swingHigh
brkShort = useBreakout and downTrend and not na(swingLow)  and close < swingLow  and close[1] >= swingLow

// 3. Range rejection: flat EMAs, wick beyond the N-bar extreme, close back inside.
rejShort = useRangeReject and flatEmas and high > rangeHigh and close < rangeHigh and close < open
rejLong  = useRangeReject and flatEmas and low  < rangeLow  and close > rangeLow  and close > open

// 4. London breakout of the Asia range (first break only, 07–11 UTC).
lonWindow = utcH >= 7 and utcH < 11
sesLong  = useSessionBreak and lonWindow and not asiaBroken and not na(asiaHigh) and close > asiaHigh and close[1] <= asiaHigh
sesShort = useSessionBreak and lonWindow and not asiaBroken and not na(asiaLow)  and close < asiaLow  and close[1] >= asiaLow

// ── Candidate levels per setup (raw chart anchors; app adds buffers) ──
f_num(x) => str.tostring(x, "#.#####")

var int lastAlertBar = -99999
cooledDown = bar_index - lastAlertBar >= cooldownBars

setupType = ""
direction = ""
float entryCand = na
float stopCand  = na
float tpCand    = na
float trigger   = na

if barstate.isconfirmed and sessionAllowed and not inDeadZone and cooledDown
    if pullLong or pullShort
        setupType := "trend_pullback"
        direction := pullLong ? "long" : "short"
        entryCand := close
        stopCand  := pullLong ? swingLow : swingHigh
        tpCand    := pullLong ? swingHigh + 0.618 * (swingHigh - swingLow) : swingLow - 0.618 * (swingHigh - swingLow)
        trigger   := emaFast
    else if brkLong or brkShort
        setupType := "breakout_continuation"
        direction := brkLong ? "long" : "short"
        entryCand := close
        stopCand  := brkLong ? swingLow : swingHigh
        tpCand    := brkLong ? swingHigh + (swingHigh - swingLow) : swingLow - (swingHigh - swingLow)
        trigger   := brkLong ? swingHigh : swingLow
    else if sesLong or sesShort
        setupType := "session_breakout"
        direction := sesLong ? "long" : "short"
        entryCand := close
        stopCand  := (asiaHigh + asiaLow) / 2
        tpCand    := sesLong ? asiaHigh + (asiaHigh - asiaLow) : asiaLow - (asiaHigh - asiaLow)
        trigger   := sesLong ? asiaHigh : asiaLow
        asiaBroken := true
    else if rejLong or rejShort
        setupType := "range_rejection"
        direction := rejLong ? "long" : "short"
        entryCand := close
        stopCand  := rejLong ? low : high
        tpCand    := rejLong ? rangeHigh : rangeLow
        trigger   := rejLong ? rangeLow : rangeHigh

// Guard: stop must sit on the correct side of entry
validLevels = not na(entryCand) and not na(stopCand) and (direction == "long" ? stopCand < entryCand : stopCand > entryCand)

// ── Alert JSON (chart-native context only) ───────────────────────────
if setupType != "" and validLevels
    payload = '{'
      + '"secret":"' + secret + '",'
      + '"source":"tradingview",'
      + '"symbol":"' + syminfo.ticker + '",'
      + '"timeframe":"' + timeframe.period + '",'
      + '"setupType":"' + setupType + '",'
      + '"direction":"' + direction + '",'
      + '"mode":"' + mode + '",'
      + '"close":' + f_num(close) + ','
      + '"high":' + f_num(high) + ','
      + '"low":' + f_num(low) + ','
      + '"atr":' + f_num(atr) + ','
      + '"emaFast":' + f_num(emaFast) + ','
      + '"emaSlow":' + f_num(emaSlow) + ','
      + (useRsi ? '"rsi":' + str.tostring(rsi, "#.#") + ',' : '')
      + '"swingHigh":' + f_num(nz(swingHigh, high)) + ','
      + '"swingLow":' + f_num(nz(swingLow, low)) + ','
      + '"sessionTag":"' + sessionTag + '",'
      + '"triggerLevel":' + f_num(trigger) + ','
      + '"entryCandidate":' + f_num(entryCand) + ','
      + '"stopCandidate":' + f_num(stopCand) + ','
      + (not na(tpCand) ? '"tpCandidate":' + f_num(tpCand) + ',' : '')
      + '"chartUrl":"https://www.tradingview.com/chart/?symbol=' + syminfo.tickerid + '",'
      + '"timestamp":' + str.tostring(time)
      + '}'
    alert(payload, alert.freq_once_per_bar_close)
    lastAlertBar := bar_index
    label.new(bar_index, direction == "long" ? low : high,
      text = (direction == "long" ? "▲ " : "▼ ") + setupType,
      style = direction == "long" ? label.style_label_up : label.style_label_down,
      color = direction == "long" ? color.new(color.teal, 20) : color.new(color.red, 20),
      textcolor = color.white, size = size.small)

// ── Visuals ──────────────────────────────────────────────────────────
plot(emaFast, "EMA fast", color = color.new(color.blue, 30))
plot(emaSlow, "EMA slow", color = color.new(color.orange, 30))
plot(na(asiaHigh) or not (inLondon or inAsia) ? na : asiaHigh, "Asia high", color = color.new(color.gray, 50), style = plot.style_linebr)
plot(na(asiaLow) or not (inLondon or inAsia) ? na : asiaLow, "Asia low", color = color.new(color.gray, 50), style = plot.style_linebr)
bgcolor(inDeadZone ? color.new(color.red, 92) : na, title = "Dead zone")
