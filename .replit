run = "npm run dev"
entrypoint = "app/page.tsx"
modules = ["nodejs-20"]

hidden = [".next", "node_modules"]

[nix]
channel = "stable-24_05"

[env]
NEXT_TELEMETRY_DISABLED = "1"

[deployment]
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80
