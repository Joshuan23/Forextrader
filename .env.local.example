# ─── FlowEdge environment ─────────────────────────────────────────
# PRODUCTION POLICY: real data by default. Demo/mock providers are
# reachable ONLY when DEVELOPMENT_DEMO_MODE=true is set explicitly.
# In production without the required services, data paths fail loudly
# with setup guidance instead of serving fake data.

# Explicit demo mode (development fallback). NEVER set in production.
# DEVELOPMENT_DEMO_MODE=true

# ─── Database (REQUIRED in production) ────────────────────────────
# Supabase/Neon Postgres. Enables persistence for signals, trade plans,
# journal, settings, webhook logs. After setting: npx prisma db push
# DATABASE_URL=postgresql://user:pass@host:5432/flowedge

# ─── Market data providers ────────────────────────────────────────
# Free key: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_key_here

# Economic calendar — Finnhub API key (free tier works):
# https://finnhub.io  — real event times drive the news-blackout layer.
# Required in production unless DEVELOPMENT_DEMO_MODE=true.
# CALENDAR_API_KEY=your_finnhub_key

# ─── TradingView webhook (REQUIRED for signal ingestion) ──────────
# Shared secret between the Pine "FlowEdge Signal Feeder" and the app.
TRADINGVIEW_WEBHOOK_SECRET=change_me_min_8_chars

# ─── Supabase (auth, entitlements, push prefs — mobile backend) ───
# Run mobile/supabase/schema.sql in the SQL editor first.
# Service role key stays server-side ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── RevenueCat (real subscriptions) ──────────────────────────────
# Webhook: RevenueCat → Integrations → Webhooks → Authorization header.
REVENUECAT_WEBHOOK_AUTH=Bearer_change_me
# Secret API key for server-side entitlement sync (POST /api/subscription/sync).
REVENUECAT_SECRET_KEY=

# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Mobile app (mobile/.env) ─────────────────────────────────────
# EXPO_PUBLIC_FLOWEDGE_API_URL=https://your-vercel-deployment.vercel.app
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_DEMO_MODE=false
