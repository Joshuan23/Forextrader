# All EXPO_PUBLIC_ vars are bundled into the app — never put secrets here.

# Supabase project (auth + data). Leave empty for full mock mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# FlowEdge web API base (signals feed). Empty → bundled sample signals.
EXPO_PUBLIC_FLOWEDGE_API_URL=

# RevenueCat public SDK keys (per platform). Empty → mock billing.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
